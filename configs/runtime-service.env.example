RUNTIME_API_TOKEN=replace-with-a-random-token-of-at-least-24-characters
RUNTIME_REPOSITORIES_FILE=artifacts/service/repositories.json
RUNTIME_DATA_DIR=artifacts/service/data
RUNTIME_LEASE_SECONDS=15
RUNTIME_TASK_TIMEOUT=300
RUNTIME_VERIFY_TIMEOUT=60
